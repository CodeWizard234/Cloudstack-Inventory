# Core
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inventory-app
JWT_SECRET=replace-with-a-strong-secret

# App branding
APP_NAME=Cloudstack Inventory
APP_URL=http://localhost:3000
# Set a public URL for logo so email clients can load it
APP_LOGO_URL=https://your-domain.com/branding/cloudstack-logo.svg

# SMTP (required for reset/welcome emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Cloudstack Inventory <noreply@your-domain.com>"

# Optional mail retry tuning
MAIL_MAX_RETRIES=3
MAIL_RETRY_BASE_DELAY_MS=1500
